# Development Environment Configuration
# This file is used when running the application with Docker Compose in development mode
# with Neon Local proxy

# Node.js Environment
NODE_ENV=development
PORT=3000
LOG_LEVEL=debug

# Database Configuration (Neon Local)
# The DATABASE_URL will be overridden by docker-compose.dev.yml to use neon-local service
DATABASE_URL=postgres://neon:npg@localhost:5432/neondb?sslmode=require
DATABASE_NAME=neondb

# Neon API Configuration (required for Neon Local)
# Get these values from your Neon Console: https://console.neon.tech
NEON_API_KEY=napi_obvc9aa64zu9xijd6q3xadx9q10227d5ozsnbapu94yuu11n4lmgsp6f2yxxgqgv
NEON_PROJECT_ID=lingering-truth-58093265
PARENT_BRANCH_ID=br-blue-mouse-a6zplhr1

# Neon Local Configuration
DELETE_BRANCH=true

# JWT Configuration
JWT_SECRET=your-development-jwt-secret-key-here

# Arcjet
ARCJET_KEY=ajkey_01m0xxxysve6hawsd4etmbkp2g

