# Production Environment Configuration
# This file is used when running the application in production mode
# with direct connection to Neon Cloud Database

# Node.js Environment
NODE_ENV=production
PORT=3000
LOG_LEVEL=info

# Database Configuration (Neon Cloud)
# Use your actual Neon Cloud database URL from https://console.neon.tech
# Example: postgres://username:password@ep-cool-darkness-123456.us-east-2.aws.neon.tech/dbname?sslmode=require
DATABASE_URL=your_production_neon_database_url_here

# JWT Configuration
JWT_SECRET=your-strong-production-jwt-secret-key-here

# Application Configuration
# Add any additional production-specific configuration here

# Security Configuration
TRUST_PROXY=true

# Monitoring Configuration
ENABLE_HEALTH_CHECKS=true

# Logging Configuration
LOG_FORMAT=json